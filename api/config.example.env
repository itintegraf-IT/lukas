# Zkopíruj tento soubor na  .env  a vyplň hodnoty.
# .env se NEcommituje do gitu (viz .gitignore) – obsahuje heslo k databázi.

PORT=3000

# MySQL / MariaDB (běží na stejném serveru → localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bobr
DB_USER=bobr
DB_PASSWORD=

# Náhodný dlouhý řetězec pro podpis sezení (klidně vygeneruj: openssl rand -hex 32)
SESSION_SECRET=

# true jen když aplikace běží za HTTPS (produkce s Let's Encrypt).
# Pro interní provoz bez HTTPS nech false.
COOKIE_SECURE=false

# První administrátor – vytvoří se jen když je tabulka uživatelů prázdná.
# Po prvním přihlášení si BOBR vynutí změnu hesla.
ADMIN_EMAIL=admin@firma.cz
ADMIN_PASSWORD=zmen-me-pri-prvnim-prihlaseni
